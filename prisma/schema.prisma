generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OPERATOR
  EDITOR
  USER
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String          @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  role           UserRole        @default(USER)
  accounts       Account[]
  sessions       Session[]
  // Optional for WebAuthn support
  Authenticator  Authenticator[]

  passwordResetTokens PasswordResetToken[] // reset passw relation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String // simpan hash dari raw token
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


model VillageConfig {
  id              Int     @id @default(autoincrement())
  villageCode     String  @unique @db.VarChar(10)
  villageName     String
  districtCode    String? @db.VarChar(6)
  districtName    String?
  regencyCode     String? @db.VarChar(4)
  regencyName     String?
  provinceCode    String? @db.VarChar(2)
  provinceName    String?
  officeAddress   String?
  postalCode      String? @db.VarChar(10)
  phone           String?
  email           String?
  website         String?
  establishedYear Int?

  // 📝 General description
  description String? @db.Text

  // 🌍 Geographic info
  areaSize        Float?
  areaUnit        String?  @default("km²")
  populationTotal Int?     @default(0)
  hamletCount     Int?     @default(0)
  rwCount         Int?     @default(0)
  rtCount         Int?     @default(0)
  borderNorth     String?
  borderEast      String?
  borderSouth     String?
  borderWest      String?
  elevation       Int?
  latitude        Decimal? @db.Decimal(10, 8)
  longitude       Decimal? @db.Decimal(11, 8)

  // 🖼️ Visual identity
  logoUrl        String?
  officePhotoUrl String?
  vision         String?
  mission        String?
  slogan         String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
